{
  "name": "bookit-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript JSON REST API for the resource-booking application (ADR-002).",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test-support/**/*.ts\" && node --check scripts/database.mjs",
    "test": "vitest run --exclude 'src/db/*.test.ts'",
    "test:integration": "vitest run src/db/*.test.ts",
    "db:provision": "node scripts/database.mjs provision",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed:dev": "node scripts/database.mjs seed:dev",
    "db:seed:test": "node scripts/database.mjs seed:test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "node-pg-migrate": "9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
